# ── 비워 두면 '시범 운영' 모드(예시 공고 + 상단 안내 띠, 지원은 시설에 전달 안 됨)
NEXT_PUBLIC_SITE_URL=https://carejobmoa.kr
NEXT_PUBLIC_INDEXABLE=0                 # 실도메인 연결 후 1 → 검색 노출 허용

# ── Supabase (Project Settings → API). 세 값이 모두 들어가면 실서비스 모드로 자동 전환
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=              # 서버 전용 · 절대 공개 금지
ADMIN_EMAILS=                           # 운영자 이메일(쉼표 구분) → /admin 접근

# ── 문자(솔라피). 비우면 문자는 서버 로그로만 남음
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SMS_SENDER=                             # 솔라피에 등록·승인된 발신번호(예: 1833-9119)
SEND_SMS_HOOK_SECRET=                   # Supabase Auth Hooks → Send SMS 에서 발급(v1,whsec_...)

# ── 운영 자동화 (Vercel 에 설정 완료)
CRON_SECRET=                            # 매일 09:00 크론(/api/cron/daily) 인증
CAREDOC_SYNC_SECRET=                    # 케어닥 앱 공고 연동 API 토큰

# ── 사업자 표시(푸터·개인정보처리방침). 빈 값은 화면에서 생략
NEXT_PUBLIC_COMPANY_CEO=
NEXT_PUBLIC_COMPANY_BIZNO=
NEXT_PUBLIC_COMPANY_MAILORDER=
NEXT_PUBLIC_COMPANY_JOBINFO=            # 직업정보제공사업 신고번호
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_TEL=
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_PRIVACY_OFFICER=            # 개인정보 보호책임자 성명·직책
NEXT_PUBLIC_PRIVACY_EMAIL=
